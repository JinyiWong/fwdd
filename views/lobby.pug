doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Python Escape Lobby
    link(rel="stylesheet", href="/css/lobby.css")
    link(href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700;800&display=swap", rel="stylesheet")

  body
    // 🟣 Header
    header.dashboard-header
      div.left-header
        div.logo
          img(src="/images/logo.png", alt="Python Escape Logo")
          div.header-text
            h1 Python Escape
            span Welcome, #{currentUser || 'user'}

      a.logout(href="/logout")
        img(src="/images/logout.png", alt="Logout", class="logout-icon")
        |  LOGOUT

    // 🟣 Main Lobby Section
    main.lobby-container
      // LEFT SIDE — Game Info
      .lobby-left.card
        h2 Game Code
        p Share this code with others to join

        if sessionCode
          .game-code-box #{sessionCode}
        else
          .game-code-box Loading...

        if qrCodeDataUrl
          img.qr-code(src=qrCodeDataUrl, alt="QR Code")
        else
          img.qr-code(src="/images/qr-placeholder.png", alt="QR Code")

        p.small-text Scan to join session

        // ✅ Host controls
        if isHost
          form(action="/start-game" method="POST" style="margin-top:15px;")
            input(type="hidden" name="sessionCode" value=sessionCode)
            button.action-btn(type="submit") START GAME

          form(action="/end-session" method="POST" id="endGameForm" style="margin-top:10px;")
            input(type="hidden" name="sessionCode" value=sessionCode)
            button.action-btn-end(type="submit" style="background:#e91e63;") END GAME
        else
          form(action="/leave-session" method="POST" id="leaveGameForm" style="margin-top:15px; text-align:center;")
            input(type="hidden" name="sessionCode" value=sessionCode)
            button.action-btn-end(type="submit" style="background:#ff9800;") LEAVE GAME

          p(style="text-align:center; color:#bbb; margin-top:10px;") Waiting for host to start the game...

      // RIGHT SIDE — Player List
      .lobby-right.card
        h2 Connected Players 
          span#playerCount (#{players && players.length ? players.length : 0})
        p Players in this session

        .player-list#playerList
          if players && players.length
            each player, index in players
              .player-item
                span.player-name= player.name || player
                if index === 0
                  span.player-role.host Host
                else
                  span.player-role Player
          else
            p(style="color:#ccc") Waiting for players to join...

    // 🧠 Script — auto refresh + game sync
    script.
      const sessionCode = "#{sessionCode}";
      const isHost = #{isHost ? 'true' : 'false'};

      // 🔁 Refresh player list every 3s
      async function fetchPlayers() {
        try {
          const res = await fetch(`/session-players/${sessionCode}`);
          if (!res.ok) return;
          const data = await res.json();

          const list = document.getElementById('playerList');
          const count = document.getElementById('playerCount');
          list.innerHTML = '';
          count.textContent = `(${data.players.length})`;

          if (data.players.length === 0) {
            list.innerHTML = '<p style="color:#ccc">Waiting for players to join...</p>';
            return;
          }

          data.players.forEach((p, i) => {
            const div = document.createElement('div');
            div.classList.add('player-item');
            div.innerHTML = `
              <span class="player-name">${p.name}</span>
              <span class="player-role ${i === 0 ? 'host' : ''}">
                ${i === 0 ? 'Host' : 'Player'}
              </span>
            `;
            list.appendChild(div);
          });
        } catch (err) {
          console.error('Error fetching players:', err);
        }
      }

      // 🕒 Refresh player list periodically
      setInterval(fetchPlayers, 3000);

      // ⚙️ Confirmations for leave / end
      document.addEventListener('DOMContentLoaded', () => {
        const leaveForm = document.getElementById('leaveGameForm');
        const endForm = document.getElementById('endGameForm');

        if (leaveForm) {
          leaveForm.addEventListener('submit', e => {
            if (!confirm("🚪 Are you sure you want to leave this game?")) e.preventDefault();
          });
        }

        if (endForm) {
          endForm.addEventListener('submit', e => {
            if (!confirm("⚠️ Are you sure you want to end this game for everyone?")) e.preventDefault();
          });
        }

        // 🟢 For players only — auto redirect when host starts
        if (!isHost) {
          async function checkGameStart() {
            try {
              const res = await fetch(`/session/${sessionCode}/status`);
              const data = await res.json();
              if (data.success && data.started) {
                console.log("🎮 Game started by host!");
                window.location.href = "/room/1";
              }
            } catch (err) {
              console.error("Error checking session start:", err);
            }
          }
          setInterval(checkGameStart, 2000); // Poll every 2 seconds
        }
      });
