doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Python Escape Lobby
    link(rel="stylesheet", href="/css/lobby.css")
    link(href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700;800&display=swap", rel="stylesheet")

  body
    // 🟣 Header
    header.dashboard-header
      div.left-header
        div.logo
          img(src="/images/logo.png", alt="Python Escape Logo")
          div.header-text
            h1 Python Escape
            span Welcome, #{currentUser || 'user'}

      a.logout(href="/logout")
        img(src="/images/logout.png", alt="Logout", class="logout-icon")
        |  LOGOUT

    // 🟣 Main Lobby Section
    main.lobby-container
      // LEFT SIDE — Game Info
      .lobby-left.card
        h2 Game Code
        p Share this code with others to join

        if sessionCode
          .game-code-box #{sessionCode}
        else
          .game-code-box Loading...

        if qrCodeDataUrl
          img.qr-code(src=qrCodeDataUrl, alt="QR Code")
        else
          img.qr-code(src="/images/qr-placeholder.png", alt="QR Code")

        p.small-text Scan to join session

        // ✅ Host controls
        if isHost
          form(action="/start-game" method="POST" style="margin-top:15px;")
            input(type="hidden" name="sessionCode" value=sessionCode)
            button.action-btn(type="submit") START GAME

          form(action="/end-session" method="POST" id="endGameForm" style="margin-top:10px;")
            input(type="hidden" name="sessionCode" value=sessionCode)
            button.action-btn-end(type="submit" style="background:#e91e63;") END GAME
        else
          form(action="/leave-session" method="POST" id="leaveGameForm" style="margin-top:15px; text-align:center;")
            input(type="hidden" name="sessionCode" value=sessionCode)
            button.action-btn-end(type="submit" style="background:#ff9800;") LEAVE GAME

          p(style="text-align:center; color:#bbb; margin-top:10px;") Waiting for host to start the game...

      // RIGHT SIDE — Player List
      .lobby-right.card
        h2 Connected Players 
          span#playerCount (#{players && players.length ? players.length : 0})
        p Players in this session

        .player-list#playerList
          if players && players.length
            each player, index in players
              .player-item
                span.player-name= player.name || player
                if index === 0
                  span.player-role.host Host
                else
                  span.player-role Player
          else
            p(style="color:#ccc") Waiting for players to join...
          
    // 🧠 Script — auto refresh + session checks
    script.
      // 🧠 Script — auto refresh + session checks
      const sessionCode = "#{sessionCode}";
      const isHost = #{isHost ? 'true' : 'false'};

      // 🔁 Refresh player list every 3s
      async function fetchPlayers() {
        try {
          const res = await fetch(`/session-players/${sessionCode}`);
          if (!res.ok) return;
          const data = await res.json();

          const list = document.getElementById('playerList');
          const count = document.getElementById('playerCount');
          list.innerHTML = '';
          count.textContent = `(${data.players.length})`;

          if (data.players.length === 0) {
            list.innerHTML = '<p style="color:#ccc">Waiting for players to join...</p>';
            return;
          }

          data.players.forEach((p, i) => {
            const div = document.createElement('div');
            div.classList.add('player-item');
            div.innerHTML = `
              <span class="player-name">${p.name}</span>
              <span class="player-role ${i === 0 ? 'host' : ''}">
                ${i === 0 ? 'Host' : 'Player'}
              </span>
            `;
            list.appendChild(div);
          });
        } catch (err) {
          console.error('Error fetching players:', err);
        }
      }

      // 🕒 Refresh player list periodically
      const fetchPlayersInterval = setInterval(fetchPlayers, 3000);

      // === Custom confirmation popup ===
      function showConfirmPopup(message, onConfirm) {
        // Create overlay
        const overlay = document.createElement('div');
        overlay.style.cssText = `
          position:fixed; inset:0; background:rgba(0,0,0,0.8);
          display:flex; justify-content:center; align-items:center; z-index:10000;
        `;

        // Create popup
        const popup = document.createElement('div');
        popup.style.cssText = `
          background:rgba(21,0,44,0.95);
          border:2px solid #e200ff;
          box-shadow:0 0 20px rgba(226,0,255,0.6);
          border-radius:20px;
          padding:30px 40px;
          text-align:center;
          color:#fff;
          max-width:420px;
          font-family:'Kumbh Sans';
        `;

        popup.innerHTML = `
          <h2 style="color:#e200ff; margin-bottom:15px; font-size:1.5rem; font-weight:700">⚠️ Confirmation</h2>
          <p style="margin-bottom:25px; font-size:1rem; line-height:1.6;">${message}</p>
          <div style="display:flex; gap:20px; justify-content:center;">
            <button id="confirmYes"
              style="padding:10px 25px; background:#e200ff; color:#15002C; border:none;
                    border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
              YES
            </button>
            <button id="confirmNo"
              style="padding:10px 25px; background:#555; color:#fff; border:none;
                    border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
              NO
            </button>
          </div>
        `;

        overlay.appendChild(popup);
        document.body.appendChild(overlay);

        // Event listeners
        document.getElementById('confirmYes').addEventListener('click', () => {
          overlay.style.opacity = '0';
          overlay.style.transition = 'opacity 0.3s ease';
          setTimeout(() => overlay.remove(), 300);
          if (onConfirm) onConfirm(true);
        });

        document.getElementById('confirmNo').addEventListener('click', () => {
          overlay.style.opacity = '0';
          overlay.style.transition = 'opacity 0.3s ease';
          setTimeout(() => overlay.remove(), 300);
          if (onConfirm) onConfirm(false);
        });
      }

      // 🎨 Popup when host ends session
      function showEndPopup(message) {
        const overlay = document.createElement('div');
        overlay.style.cssText = `
          position:fixed; inset:0; background:rgba(0,0,0,0.85); color:#fff;
          display:flex; flex-direction:column; justify-content:center; align-items:center;
          font-family:'Kumbh Sans'; z-index:9999; text-align:center;
        `;
        overlay.innerHTML = `
          <div style="background:rgba(21,0,44,0.95); border:2px solid #e200ff; box-shadow:0 0 20px rgba(226,0,255,0.6);
                      border-radius:20px; padding:30px 40px; max-width:420px;">
            <h2 style="color:#e200ff; margin-bottom:10px;">⚠️ Game Ended</h2>
            <p style="margin-bottom:25px; line-height:1.5;">${message}</p>
            <button id="backBtn"
              style="padding:10px 25px; background:#e200ff; color:#15002C; border:none;
                    border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
              OK
            </button>
          </div>
        `;
        document.body.appendChild(overlay);

        document.getElementById('backBtn').addEventListener('click', () => {
          window.location.href = '/dashboard';
        });

        // Auto redirect after 5 seconds
        setTimeout(() => window.location.href = '/dashboard', 5000);
      }

      // 🧩 Detect if host ends the session (FOR ALL PLAYERS)
      async function checkSessionActive() {
        try {
          const res = await fetch(`/session/${sessionCode}/active`);
          const data = await res.json();

          if (!data.active) {
            console.warn("⚠️ Host ended the session — redirecting...");
            
            // Clear all intervals
            clearInterval(fetchPlayersInterval);
            if (window.checkGameStartInterval) {
              clearInterval(window.checkGameStartInterval);
            }
            clearInterval(checkSessionInterval);
            
            showEndPopup("⚠️ The host has ended the game. You will be returned to the dashboard.");
          }
        } catch (err) {
          console.error("Error checking session activity:", err);
        }
      }

      // ⚙️ Confirmations for leave / end + Game start detection
      document.addEventListener('DOMContentLoaded', () => {
        const leaveForm = document.getElementById('leaveGameForm');
        const endForm = document.getElementById('endGameForm');

        if (leaveForm) {
          leaveForm.addEventListener('submit', e => {
            e.preventDefault();
            showConfirmPopup("🚪 Are you sure you want to leave this game?", (confirmed) => {
              if (confirmed) leaveForm.submit();
            });
          });
        }

        if (endForm) {
          endForm.addEventListener('submit', e => {
            e.preventDefault();
            showConfirmPopup("⚠️ Are you sure you want to end this game for everyone?", (confirmed) => {
              if (confirmed) endForm.submit();
            });
          });
        }


        // 🟢 For players only — auto redirect when host starts
        if (!isHost) {
          async function checkGameStart() {
            try {
              const res = await fetch(`/session/${sessionCode}/status`);
              const data = await res.json();
              if (data.success && data.started) {
                console.log("🎮 Game started by host!");
                window.location.href = "/room/1";
              }
            } catch (err) {
              console.error("Error checking session start:", err);
            }
          }
          // Store in window scope so it can be cleared
          window.checkGameStartInterval = setInterval(checkGameStart, 2000);
        }
      });

      // 🔁 Check session status every 3s (FOR ALL PLAYERS, including host)
      const checkSessionInterval = setInterval(checkSessionActive, 3000);