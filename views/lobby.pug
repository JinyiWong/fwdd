doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Python Escape Dashboard
    link(rel="stylesheet", href="/css/lobby.css")
    link(href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700;800&display=swap", rel="stylesheet")

  body
    header.dashboard-header
      div.left-header
        a.back(href="/dashboard")
          img(src="/images/back.png", alt="Back", class="back-icon")
          | Back

        div.logo
          img(src="/images/logo.png", alt="Python Escape Logo")
          div.header-text
            h1 Python Escape
            span Welcome, user

      a.logout(href="/logout")
        img(src="/images/logout.png", alt="Logout", class="logout-icon")
        | LOGOUT

    main.lobby-container
      .lobby-left.card
        h2 Game Code
        p Share this code with others to join
        .game-code-box HGYN987
        img.qr-code(src="/images/qr.png", alt="QR Code")
        p.small-text Scan to join session
        button.action-btn(type="button") START GAME

      .lobby-right.card
        h2 Connected Players (2)
        p Players in this session
        .player-list
          .player-item
            span.player-name Spring_04
            span.player-role.host Host
          .player-item
            span.player-name Wind_55
            span.player-role Player
