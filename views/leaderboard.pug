                td 3
                td Jinyi
                td 1495
                td 10:08
            tr
                td 4
                td Gene
                td 1490
                td 10:08
            tr
                td 5
                td Momo
                td 1380
                td 10:08
            tr
                td 6
                td Meoww
                td 1300
                td 10:08

            // 👇 Separate “YOU” as the sticky bottom row
