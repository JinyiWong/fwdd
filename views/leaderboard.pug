extends layout/dashboard.layout.pug

block content
  main.dashboard
    .card.leaderboard
      h2 Leaderboard
      p The best of the best—can you beat them?

      table.leaderboard-table
        thead
          tr
            th Rank
            th Player
            th Score
            th Time Taken (minutes)
        tbody.scrollable
          if leaderboard && leaderboard.length
            each player in leaderboard
              tr(class=player.isCurrentUser ? 'highlight-row' : '')
                td #{player.rank}
                td #{player.isCurrentUser ? player.name + ' (You)' : player.name}
                td #{player.score}
                td #{player.time}
          else
            tr
              td(colspan="4" style="text-align:center; color:#999;") No records yet.

        if youData
          tfoot
            tr.you-row
              td #{youData.rank}
              td #{youData.name}
              td #{youData.score}
              td #{youData.time}
