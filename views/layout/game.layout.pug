doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Python Escape - In Game
    link(rel="stylesheet", href="/css/game.css")
    link(href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700;800&display=swap", rel="stylesheet")

  body
    header.game-header
      div.left-header
        div.logo
          img(src="/images/logo.png", alt="Python Escape Logo")
          div.header-text
            h1#roomNameHeader= room.room_name
            span#roomProgress Room #{room.room_order} / 4

      div.right-header
        div.timer
          img.icon(src="/images/clock.png", alt="Time")
          span#gameTimer 00:00
        div.score
          img.icon(src="/images/medal.png", alt="Score")
          span#playerScore 0
        button.leave-btn(type="button", id="leaveBtn") Leave Game
        form#leaveForm(action="/leave-game", method="POST" style="display:none")
          input(type="hidden" name="sessionCode" value=sessionCode)

    main.game-container
      block content

    // 🧠 Persistent Timer + Live Score + Leave Logic
    script.
      (function() {
        const sessionId = '#{sessionCode}' || null;
        let elapsedSeconds = 0;
        let timerInterval = null;
        let scoreInterval = null;

        // ======= Neon Alert Popup =======
        function showAlertPopup(message, callback) {
          const overlay = document.createElement('div');
          overlay.style.cssText = `
            position:fixed; inset:0; background:rgba(0,0,0,0.8);
            display:flex; justify-content:center; align-items:center; z-index:10000;
            opacity:0; transition:opacity 0.3s ease;
          `;
          const popup = document.createElement('div');
          popup.style.cssText = `
            background:rgba(21,0,44,0.95);
            border:2px solid #e200ff;
            box-shadow:0 0 20px rgba(226,0,255,0.6);
            border-radius:20px;
            padding:30px 40px;
            text-align:center;
            color:#fff;
            max-width:420px;
            font-family:'Kumbh Sans';
          `;
          popup.innerHTML = `
            <h2 style="color:#e200ff; margin-bottom:15px; font-size:1.5rem; font-weight:700">⚠️ Notice</h2>
            <p style="margin-bottom:25px; font-size:1rem; line-height:1.6;">${message}</p>
            <button id="alertOk_${Date.now()}"
              style="padding:10px 25px; background:#e200ff; color:#15002C; border:none;
                    border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
              OK
            </button>
          `;
          overlay.appendChild(popup);
          document.body.appendChild(overlay);
          requestAnimationFrame(() => (overlay.style.opacity = '1'));

          const okBtn = popup.querySelector('button');
          okBtn.addEventListener('click', () => {
            overlay.style.opacity = '0';
            setTimeout(() => overlay.remove(), 300);
            if (callback) callback();
          });
        }

        // ======= Neon Confirmation Popup =======
        function showConfirmPopup(message, onConfirm) {
          const overlay = document.createElement('div');
          overlay.style.cssText = `
            position:fixed; inset:0; background:rgba(0,0,0,0.8);
            display:flex; justify-content:center; align-items:center; z-index:10000;
            opacity:0; transition:opacity 0.3s ease;
          `;
          const popup = document.createElement('div');
          popup.style.cssText = `
            background:rgba(21,0,44,0.95);
            border:2px solid #e200ff;
            box-shadow:0 0 20px rgba(226,0,255,0.6);
            border-radius:20px;
            padding:30px 40px;
            text-align:center;
            color:#fff;
            max-width:420px;
            font-family:'Kumbh Sans';
          `;

          const uid = Math.random().toString(36).slice(2);
          const yesId = `confirmYes_${uid}`;
          const noId = `confirmNo_${uid}`;

          popup.innerHTML = `
            <h2 style="color:#e200ff; margin-bottom:15px; font-size:1.5rem; font-weight:700">⚠️ Confirmation</h2>
            <p style="margin-bottom:25px; font-size:1rem; line-height:1.6;">${message}</p>
            <div style="display:flex; gap:20px; justify-content:center;">
              <button id="${yesId}"
                style="padding:10px 25px; background:#e200ff; color:#15002C; border:none;
                      border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
                YES
              </button>
              <button id="${noId}"
                style="padding:10px 25px; background:#555; color:#fff; border:none;
                      border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
                NO
              </button>
            </div>
          `;
          overlay.appendChild(popup);
          document.body.appendChild(overlay);
          requestAnimationFrame(() => (overlay.style.opacity = '1'));

          function close(confirmed) {
            overlay.style.opacity = '0';
            setTimeout(() => overlay.remove(), 300);
            if (onConfirm) onConfirm(confirmed);
          }

          document.getElementById(yesId).addEventListener('click', () => close(true));
          document.getElementById(noId).addEventListener('click', () => close(false));
        }

        // ======= Timer =======
        async function initTimer() {
          try {
            const res = await fetch('/session/time-elapsed');
            const data = await res.json();
            if (data.success) elapsedSeconds = data.elapsedSeconds;
          } catch (err) {
            console.error('⏱️ Failed to fetch initial elapsed time:', err);
          }

          updateTimerDisplay();
          timerInterval = setInterval(() => {
            elapsedSeconds++;
            updateTimerDisplay();
          }, 1000);
        }

        function updateTimerDisplay() {
          const min = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
          const sec = String(elapsedSeconds % 60).padStart(2, '0');
          const timerEl = document.getElementById('gameTimer');
          if (timerEl) timerEl.textContent = `${min}:${sec}`;
        }

        // ======= Live Score =======
        async function fetchScore() {
          if (!sessionId) return;
          try {
            const res = await fetch(`/session/${sessionId}/score`);
            if (!res.ok) throw new Error('Bad response');
            const data = await res.json();
            if (data.success) {
              const scoreEl = document.getElementById('playerScore');
              if (scoreEl) scoreEl.textContent = data.score ?? 0;
            }
          } catch (err) {
            console.error('⚠️ Failed to fetch score:', err);
          }
        }

        // ======= Leave Game (custom confirmation & alert) =======
        const leaveBtn = document.getElementById('leaveBtn');
        if (leaveBtn) {
          leaveBtn.addEventListener('click', async () => {
            const confirmLeave = await new Promise(resolve =>
              showConfirmPopup('⚠️ Are you sure you want to leave the game? Your time and score will be saved.', resolve)
            );
            if (!confirmLeave) return;

            try {
              const res = await fetch('/leave-game', { method: 'POST' });
              const data = await res.json().catch(() => ({}));
              if (res.ok && (data.success || res.status === 200)) {
                showAlertPopup('👋 You have left the game. Your progress and time are saved.', () => {
                  window.location.href = '/dashboard';
                });
              } else {
                showAlertPopup(data.message || '⚠️ Failed to leave the game.');
              }
            } catch (err) {
              console.error('❌ Leave game error:', err);
              showAlertPopup('Server error while leaving.');
            }
          });
        }

        // ======= Init systems =======
        initTimer();
        fetchScore();
        scoreInterval = setInterval(fetchScore, 3000);

        // ======= Cleanup =======
        window.addEventListener('beforeunload', () => {
          if (timerInterval) clearInterval(timerInterval);
          if (scoreInterval) clearInterval(scoreInterval);
        });
      })();
