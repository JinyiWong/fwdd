extends layout/dashboard.layout.pug

block content
  main.dashboard
    .card.history
      h2 Escape History
      p Your past escape room sessions

      if history.length
        table
          thead
            tr
              th No
              th Game Code
              th Score
              th Rank
              th Time Taken
              th Date
              th Action
          tbody
            each h in history
              tr
                td= h.no
                td= h.code
                td= h.score
                td 
                  span.rank-badge #{'#' + h.rank}
                td= h.time
                td= h.date
                td 
                  a.btn.btn-view(href=`/history/${h.code}`) View Details
      else
        p.no-data No history found.
