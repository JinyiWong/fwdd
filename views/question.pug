extends layout/game.layout.pug

block content
  section.question-container
    .card.question-box
      h3 Question :
      p= question.question_text

      // Hidden fields for backend
      input(type="hidden" id="questionId" value=question.question_id)
      input(type="hidden" id="itemId" value=item.item_id)
      input(type="hidden" id="roomId" value=item.room_id)

      .answers
        button.answer-btn(data-option="A")= question.option_a
        button.answer-btn(data-option="B")= question.option_b
        button.answer-btn(data-option="C")= question.option_c
        button.answer-btn(data-option="D")= question.option_d

    .card.power-cards
      h3 Power Cards Collected
      p Power Cards give bonus points when used strategically
      #powerCardList
        p(style="color:#aaa;") Loading your power cards...

  // 🟣 Popup for results
  div#popupPanel(
    style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:9999; justify-content:center; align-items:center; flex-direction:column; color:#fff; font-family:'Kumbh Sans'; text-align:center; padding:20px;"
  )
    .popup-card(
      style="background:#222; padding:30px 40px; border-radius:15px; box-shadow:0 0 25px rgba(255,255,255,0.3); max-width:450px;"
    )
      h2#popupTitle(style="margin-bottom:15px; font-size:24px; font-weight:700") Result
      p#popupMsg(style="margin-bottom:25px; font-size:18px; line-height:1.5")
      button#popupBtn(
        style="padding:10px 25px; background:#4caf50; color:#fff; border:none; border-radius:8px; font-size:16px; cursor:pointer;"
      ) OK

  // ❄️ Freeze overlay
  div#freezeOverlay(
    style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9998; justify-content:center; align-items:center; flex-direction:column; color:#fff; font-family:'Kumbh Sans'; font-size:2rem; font-weight:700; letter-spacing:1px;"
  )
    | 🧊 Oops! Frozen... Please wait ⏳

  // 🧠 Interactive Script
  script.
    (function() {
      let startTime = Date.now();

      // ======= Neon Alert Popup =======
      function showAlertPopup(message, callback) {
        const overlay = document.createElement('div');
        overlay.style.cssText = `
          position:fixed; inset:0; background:rgba(0,0,0,0.8);
          display:flex; justify-content:center; align-items:center; z-index:10000;
          opacity:0; transition:opacity 0.3s ease;
        `;
        const popup = document.createElement('div');
        popup.style.cssText = `
          background:rgba(21,0,44,0.95);
          border:2px solid #e200ff;
          box-shadow:0 0 20px rgba(226,0,255,0.6);
          border-radius:20px;
          padding:30px 40px;
          text-align:center;
          color:#fff;
          max-width:420px;
          font-family:'Kumbh Sans';
        `;
        popup.innerHTML = `
          <h2 style="color:#e200ff; margin-bottom:15px; font-size:1.5rem; font-weight:700">⚠️ Notice</h2>
          <p style="margin-bottom:25px; font-size:1rem; line-height:1.6;">${message}</p>
          <button id="alertOk_${Date.now()}"
            style="padding:10px 25px; background:#e200ff; color:#15002C; border:none;
                   border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
            OK
          </button>
        `;
        overlay.appendChild(popup);
        document.body.appendChild(overlay);
        requestAnimationFrame(() => (overlay.style.opacity = '1'));

        const okBtn = popup.querySelector('button');
        okBtn.addEventListener('click', () => {
          overlay.style.opacity = '0';
          setTimeout(() => overlay.remove(), 300);
          if (callback) callback();
        });
      }

      // ======= Neon Confirmation Popup =======
      function showConfirmPopup(message, onConfirm) {
        const overlay = document.createElement('div');
        overlay.style.cssText = `
          position:fixed; inset:0; background:rgba(0,0,0,0.8);
          display:flex; justify-content:center; align-items:center; z-index:10000;
          opacity:0; transition:opacity 0.3s ease;
        `;
        const popup = document.createElement('div');
        popup.style.cssText = `
          background:rgba(21,0,44,0.95);
          border:2px solid #e200ff;
          box-shadow:0 0 20px rgba(226,0,255,0.6);
          border-radius:20px;
          padding:30px 40px;
          text-align:center;
          color:#fff;
          max-width:420px;
          font-family:'Kumbh Sans';
        `;

        const uid = Math.random().toString(36).slice(2);
        const yesId = `confirmYes_${uid}`;
        const noId = `confirmNo_${uid}`;

        popup.innerHTML = `
          <h2 style="color:#e200ff; margin-bottom:15px; font-size:1.5rem; font-weight:700">⚠️ Confirmation</h2>
          <p style="margin-bottom:25px; font-size:1rem; line-height:1.6;">${message}</p>
          <div style="display:flex; gap:20px; justify-content:center;">
            <button id="${yesId}"
              style="padding:10px 25px; background:#e200ff; color:#15002C; border:none;
                     border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
              YES
            </button>
            <button id="${noId}"
              style="padding:10px 25px; background:#555; color:#fff; border:none;
                     border-radius:8px; font-weight:700; cursor:pointer; font-size:1rem;">
              NO
            </button>
          </div>
        `;
        overlay.appendChild(popup);
        document.body.appendChild(overlay);
        requestAnimationFrame(() => (overlay.style.opacity = '1'));

        function close(confirmed) {
          overlay.style.opacity = '0';
          setTimeout(() => overlay.remove(), 300);
          if (onConfirm) onConfirm(confirmed);
        }

        document.getElementById(yesId).addEventListener('click', () => close(true));
        document.getElementById(noId).addEventListener('click', () => close(false));
      }

      // ======= Disable all answer buttons =======
      function disableButtons() {
        document.querySelectorAll('.answer-btn').forEach(btn => {
          btn.disabled = true;
          btn.style.opacity = '0.5';
        });
      }

      // 🟢 Popup helper for results
      function showPopup(title, message, callback, color = '#4caf50') {
        const popup = document.getElementById('popupPanel');
        const titleEl = document.getElementById('popupTitle');
        const msgEl = document.getElementById('popupMsg');
        const btn = document.getElementById('popupBtn');

        titleEl.textContent = title;
        msgEl.textContent = message;
        btn.style.background = color;

        popup.style.display = 'flex';
        setTimeout(() => {
          popup.style.display = 'none';
          if (callback) callback();
        }, 2000);
      }

      // ======= Submit Answer =======
      document.querySelectorAll('.answer-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          disableButtons();
          const selected = btn.dataset.option;
          const questionId = document.getElementById('questionId').value;
          const itemId = document.getElementById('itemId').value;
          const roomId = document.getElementById('roomId').value;
          const timeTaken = Math.floor((Date.now() - startTime) / 1000);

          try {
            const res = await fetch('/submit-answer', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ questionId, selectedOption: selected, timeTaken, itemId })
            });

            const data = await res.json();

            if (data.redirectUrl) {
              showPopup('🎉 Escaped!', 'You completed all rooms successfully!', () => {
                window.location.href = data.redirectUrl;
              }, '#4caf50');
              return;
            }

            if (data.retryAllowed) {
              showPopup('🍀 Lucky Card!', data.message, () => {
                document.querySelectorAll('.answer-btn').forEach(b => {
                  b.disabled = false;
                  b.style.opacity = '1';
                });
                startTime = Date.now();
              }, '#ffeb3b');
              return;
            }

            let msg = data.message || '';
            if (data.bonusMarks && data.bonusMarks > 0)
              msg += ` 🏅 Bonus +${data.bonusMarks} marks!`;

            const color = data.isCorrect ? '#4caf50' : '#f44336';
            const title = data.isCorrect ? '✅ Correct!' : '❌ Wrong!';

            showPopup(title, msg, () => {
              window.location.href = `/room/${roomId}`;
            }, color);

          } catch (err) {
            console.error('❌ Error submitting answer:', err);
            showPopup('Error', 'Server error while submitting your answer.', null, '#ff9800');
          }
        });
      });

      // ======= Load Power Cards =======
      async function loadPowerCards() {
        try {
          const res = await fetch('/power-cards');
          const data = await res.json();
          const container = document.getElementById('powerCardList');
          container.innerHTML = '';

          if (!data.hasCards || !data.powerCards.length) {
            container.innerHTML = '<p style="color:#aaa;">No power cards collected yet.</p>';
            return;
          }

          data.powerCards.forEach(card => {
            const div = document.createElement('div');
            div.className = 'power-card';
            div.innerHTML = `
              <img class="icon" src="/images/power_${card.power_card_type.toLowerCase()}.png" alt="${card.power_card_type}" />
              <div class="power-info">
                <strong>${card.power_card_type}</strong>
                <p>${card.item_description}</p>
              </div>
            `;
            const btn = document.createElement('button');
            if (card.is_activated === 1) {
              btn.textContent = 'Used';
              btn.disabled = true;
              btn.className = 'small-btn used';
              btn.style.opacity = '0.6';
            } else {
              btn.textContent = 'Activate';
              btn.className = 'small-btn';
              btn.addEventListener('click', () => activatePowerCard(card.power_card_type));
            }
            div.appendChild(btn);
            container.appendChild(div);
          });
        } catch (err) {
          console.error('Error loading power cards:', err);
        }
      }

      // ======= Activate Power Card =======
      async function activatePowerCard(type) {
        const confirmUse = await new Promise(resolve =>
          showConfirmPopup(`Activate ${type} power card?`, resolve)
        );
        if (!confirmUse) return;

        try {
          const res = await fetch('/activate-power-card', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type })
          });
          const result = await res.json();
          showAlertPopup(result.message, () => loadPowerCards());
        } catch (err) {
          showAlertPopup('⚠️ Error activating card.');
        }
      }

      loadPowerCards();

      // ======= 🔄 Check Freeze Status =======
      async function checkFreezeStatus() {
        try {
          const res = await fetch('/session/freeze-status');
          const data = await res.json();
          const overlay = document.getElementById('freezeOverlay');

          if (data.frozen) {
            document.body.style.pointerEvents = 'none';
            document.body.style.opacity = '0.5';
            overlay.style.display = 'flex';
          } else {
            document.body.style.pointerEvents = 'auto';
            document.body.style.opacity = '1';
            overlay.style.display = 'none';
          }
        } catch (err) {
          console.error('Freeze check failed:', err);
        }
      }

      setInterval(checkFreezeStatus, 2000);
    })();
