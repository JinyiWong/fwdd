extends layout/game.layout.pug

block content
  main.room-layout
    section.left-column
      .card.room-intro
        img.room-img(src=room.room_image, alt="Room Image", id="roomImage")
        h2#roomName= room.room_name
        p#roomDesc= room.room_description || 'Explore the room and find hidden items.'

      .card.room-progress
        h3 Room Progress
        p#progressText Collect #{totalRequired} required item(s) to unlock the next room
        .progress-bar
          .progress#progressBar(style="width: #{progressPercent}%")
        p.progress-text#progressCount #{collectedRequired} / #{totalRequired}
        button.action-btn(type="button", id="scanBtn") Scan QR Code

      // 🔮 Power Card Section
      .card.power-cards
        h3 Power Cards Collected
        p Use your power cards wisely to get an advantage!
        #powerCardList
          p(style="color:#aaa;") Loading your power cards...

    section.right-column
      .card.items
        h3#itemHeader Discovered Items (#{collectedIds.length} / #{items.length})
        #itemList
          each item in items
            - const isCollected = collectedIds.includes(item.item_id);
            .item(class=isCollected ? '' : 'locked')
              div
                strong= item.item_name || '???'
                if item.is_required
                  span.tag REQUIRED
                p= isCollected ? item.item_description : 'Scan QR to unlock'
              if isCollected
                img.lock(src="/images/unlock.png", alt="Unlocked")
              else
                img.lock(src="/images/lock.png", alt="Locked")

  // 🔒 Scanner overlay (unchanged)
  div#qrScannerContainer(style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; justify-content:center; align-items:center; flex-direction:column; color:#fff; transition:opacity 0.3s;")
    h2(style="margin-bottom:10px; font-weight:500") Scanning Item QR Code...
    div#qrScanner(style="width:320px; height:320px; background:#000; border-radius:10px; overflow:hidden; box-shadow:0 0 15px rgba(255,255,255,0.3);")
    button#closeScanner(style="margin-top:20px; padding:10px 25px; background:#e91e63; color:#fff; border:none; border-radius:8px; cursor:pointer; font-weight:600;") Close Scanner

  // 🎉 Popup overlay (for room cleared / escape)
  div#popupPanel(
    style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:9998; justify-content:center; align-items:center; flex-direction:column; color:#fff; font-family:'Kumbh Sans'; text-align:center;"
  )
    .popup-card(style="background:#222; padding:30px 40px; border-radius:15px; box-shadow:0 0 25px rgba(255,255,255,0.3); max-width:450px;")
      h2#popupTitle(style="margin-bottom:15px; font-size:24px; font-weight:700") 🎉 Congratulations!
      p#popupMsg(style="margin-bottom:25px; font-size:18px; line-height:1.5") You have successfully escaped this room!
      button#popupBtn(style="padding:10px 25px; background:#4caf50; color:#fff; border:none; border-radius:8px; font-size:16px; cursor:pointer;") Continue

  // ❄️ Freeze overlay
  div#freezeOverlay(
    style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9997; justify-content:center; align-items:center; flex-direction:column; color:#fff; font-family:'Kumbh Sans'; font-size:2rem; font-weight:700;"
  )
    | 🧊 Frozen... Please wait ⏳

  // ✅ QR library
  script(src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js")

  // 🧠 Page logic
  script.
    (function() {
      const roomId = #{room.room_id};

      // ======= Show Popup Function =======
      function showPopup(message, redirectUrl) {
        const popup = document.getElementById('popupPanel');
        const msgEl = document.getElementById('popupMsg');
        const btn = document.getElementById('popupBtn');
        msgEl.textContent = message;
        popup.style.display = 'flex';
        btn.addEventListener('click', () => window.location.href = redirectUrl);
        setTimeout(() => window.location.href = redirectUrl, 2000);
      }

      // ======= Refresh Progress =======
      async function refreshProgress() {
        try {
          const bar = document.getElementById('progressBar');
          if (!bar) return;

          const currentPath = window.location.pathname;
          const match = currentPath.match(/\/room\/(\d+)/);
          const dynamicRoomId = match ? match[1] : roomId;

          const res = await fetch(`/room/${dynamicRoomId}/progress`);
          const data = await res.json();
          if (!data.success) return;

          bar.style.width = data.progressPercent + '%';
          document.getElementById('progressCount').textContent =
            `${data.collectedRequired} / ${data.totalRequired}`;

          const list = document.getElementById('itemList');
          list.innerHTML = '';
          data.items.forEach(item => {
            const collected = data.collectedIds.includes(item.item_id);
            const div = document.createElement('div');
            div.className = collected ? 'item' : 'item locked';
            div.innerHTML = `
              <div>
                <strong>${item.item_name || '???'}</strong>
                ${item.is_required ? '<span class="tag">REQUIRED</span>' : ''}
                <p>${collected ? item.item_description : 'Scan QR to unlock'}</p>
              </div>
              <img class="lock" src="/images/${collected ? 'unlock' : 'lock'}.png" alt="${collected ? 'Unlocked' : 'Locked'}" />
            `;
            list.appendChild(div);
          });

          const totalCollected = data.collectedIds.length;
          const totalItems = data.items.length;
          document.getElementById('itemHeader').textContent =
            `Discovered Items (${totalCollected} / ${totalItems})`;

          // 🎉 Auto next-room / escape logic
          if (data.progressPercent === 100) {
            clearInterval(refreshInterval);
            const isFinalRoom = #{isFinalRoom ? 'true' : 'false'};
            if (isFinalRoom) {
              showPopup('🎉 You have escaped the final room!', '/question_recap');
            } else {
              showPopup('🎉 You have cleared this room!', '/room/' + (parseInt(dynamicRoomId) + 1));
            }
          }

        } catch (err) {
          console.error('Refresh failed:', err);
        }
      }

      refreshProgress();
      const refreshInterval = setInterval(refreshProgress, 3000);
      window.addEventListener('beforeunload', () => clearInterval(refreshInterval));

      // ======= Load Power Cards =======
      async function loadPowerCards() {
        try {
          const res = await fetch('/power-cards');
          const data = await res.json();
          const container = document.getElementById('powerCardList');
          container.innerHTML = '';

          if (!data.hasCards) {
            container.innerHTML = '<p style="color:#aaa;">No power cards collected yet.</p>';
            return;
          }

          data.powerCards.forEach(card => {
            const div = document.createElement('div');
            div.className = 'power-card';
            div.innerHTML = `
              <img class="icon" src="/images/power_${card.power_card_type.toLowerCase()}.png" alt="${card.power_card_type}" />
              <div class="power-info">
                <strong>${card.power_card_type}</strong>
              </div>
            `;

            const btn = document.createElement('button');
            if (card.is_activated) {
              btn.textContent = 'Used';
              btn.disabled = true;
              btn.className = 'small-btn used';
              btn.style.opacity = '0.6';
            } else {
              btn.textContent = 'Activate';
              btn.className = 'small-btn';
              btn.onclick = async () => {
                btn.disabled = true;
                btn.textContent = 'Activating...';
                await activatePowerCard(card.power_card_type);
                // ✅ After activation, check DB immediately
                await checkPowerCardStatus();
              };
            }

            div.appendChild(btn);
            container.appendChild(div);
          });
        } catch (err) {
          console.error('Error loading power cards:', err);
        }
      }

      // ======= Activate Power Card =======
      async function activatePowerCard(type) {
        const confirmUse = confirm(`Activate ${type} power card?`);
        if (!confirmUse) return;

        try {
          const res = await fetch('/activate-power-card', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type })
          });
          const result = await res.json();

          // 🧊 Optional local freeze feedback
          if (result.success && type.toLowerCase() === 'freeze') {
            const overlay = document.getElementById('freezeOverlay');
            overlay.style.display = 'flex';
            setTimeout(() => (overlay.style.display = 'none'), 10000);
          }

          alert(result.message);

          // ✅ Immediately verify with database
          if (result.success) {
            await checkPowerCardStatus();
          }
        } catch (err) {
          console.error('⚠️ Error activating card:', err);
          alert('⚠️ Error activating card.');
        }
      }

      // ======= Check Power Card Status (NEW) =======
      async function checkPowerCardStatus() {
        try {
          const res = await fetch('/power-card-status');
          const data = await res.json();
          if (!data.success) return;

          // Update UI instantly based on DB result
          data.powerCards.forEach(card => {
            const buttons = document.querySelectorAll('.power-card button');
            buttons.forEach(btn => {
              const parent = btn.closest('.power-card');
              const strongEl = parent.querySelector('strong');
              if (strongEl && strongEl.textContent.trim().toLowerCase() === card.power_card_type.toLowerCase()) {
                if (card.is_activated) {
                  btn.textContent = 'Used';
                  btn.disabled = true;
                  btn.className = 'small-btn used';
                  btn.style.opacity = '0.6';
                } else {
                  btn.textContent = 'Activate';
                  btn.disabled = false;
                  btn.className = 'small-btn';
                  btn.style.opacity = '1';
                }
              }
            });
          });
        } catch (err) {
          console.error('Error checking power card status:', err);
        }
      }

      loadPowerCards();

      // ======= 🔄 Freeze Check (unchanged) =======
      async function checkFreezeStatus() {
        try {
          const res = await fetch('/session/freeze-status');
          const data = await res.json();
          const overlay = document.getElementById('freezeOverlay');
          if (data.frozen) {
            document.body.style.pointerEvents = 'none';
            document.body.style.opacity = '0.5';
            overlay.style.display = 'flex';
          } else {
            document.body.style.pointerEvents = 'auto';
            document.body.style.opacity = '1';
            overlay.style.display = 'none';
          }
        } catch (err) {
          console.error('Freeze check failed:', err);
        }
      }
      setInterval(checkFreezeStatus, 2000);

      // ======= QR Scanner (your original, untouched) =======
      const scanBtn = document.getElementById('scanBtn');
      const qrContainer = document.getElementById('qrScannerContainer');
      const closeBtn = document.getElementById('closeScanner');
      let html5QrCode = null;
      let isScanning = false;

      function stopScanner() {
        if (html5QrCode && isScanning) {
          html5QrCode.stop().then(() => {
            qrContainer.style.opacity = 0;
            setTimeout(() => (qrContainer.style.display = 'none'), 200);
            html5QrCode = null;
            isScanning = false;
          });
        } else {
          qrContainer.style.opacity = 0;
          setTimeout(() => (qrContainer.style.display = 'none'), 200);
          isScanning = false;
        }
      }

      scanBtn.addEventListener('click', async () => {
        if (isScanning) return;
        qrContainer.style.display = 'flex';
        qrContainer.style.opacity = 1;
        try {
          html5QrCode = new Html5Qrcode("qrScanner");
          const cameras = await Html5Qrcode.getCameras();
          const cameraId = cameras.length > 1 ? cameras[1].id : cameras[0].id;
          await html5QrCode.start(
            cameraId,
            { fps: 10, qrbox: { width: 250, height: 250 } },
            async (decodedText) => {
              stopScanner();
              if (decodedText.includes('/item/')) {
                const itemId = decodedText.split('/item/')[1];
                try {
                  const res = await fetch(`/item/${itemId}`);
                  const text = await res.text();
                  try {
                    const data = JSON.parse(text);
                    if (!data.success) { alert(data.message); return; }
                  } catch {
                    document.open(); document.write(text); document.close();
                  }
                } catch {
                  alert('❌ Failed to process item.');
                }
              } else {
                alert('Invalid QR code.');
              }
            }
          );
          isScanning = true;
        } catch (err) {
          console.error('Camera error:', err);
          alert('Camera error: ' + (err.message || err));
          qrContainer.style.display = 'none';
          isScanning = false;
        }
      });

      closeBtn.addEventListener('click', stopScanner);
    })();
