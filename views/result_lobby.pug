doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Result Lobby
    link(rel="stylesheet", href="/css/result.lobby.css")
    link(href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700;800&display=swap", rel="stylesheet")

  body
    header.dashboard-header
      div.left-header
        a.back(href="/dashboard")
          img(src="/images/back.png", alt="Back", class="back-icon")
          | Back

        div.logo
          img(src="/images/logo.png", alt="Python Escape Logo")
          div.header-text
            h1 Results Lobby
            span Waiting for other players to escape......

      a.logout(href="/logout")
        img(src="/images/logout.png", alt="Logout", class="logout-icon")
        | LOGOUT

    main.result-lobby
      .result-card
        h2 Congrats! You have escaped!

        .stats-container
          .stat
            h3 1050
            p Score
          .stat
            h3 30:08
            p Time Taken
          .stat
            h3 15/16
            p Items
          .stat
            h3 98%
            p Accuracy

        .button-group
          button.btn-primary View Answered Question
          button.btn-secondary Back to Home
