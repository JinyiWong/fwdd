extends layout/auth.layout.pug

block content
  main.auth
    .auth-container
      h2 Register
      form(action="/register" method="POST")
        .form-group
          label(for="username") Username
          input(type="text" id="username" name="username" value=(username || ''))
          if errors && errors.username
            p.error-message(style="color:red")= errors.username

        .form-group
          label(for="email") Email
          input(type="email" id="email" name="email" value=(email || ''))
          if errors && errors.email
            p.error-message(style="color:red")= errors.email

        .form-group.password-group
          label(for="password") Password
          .password-wrapper
            input(type="password" id="password" name="password")
            button(type="button" class="toggle-password" onclick="togglePassword('password', this)")
              i(class="fa fa-eye")
          if errors && errors.password
            p.error-message(style="color:red")= errors.password

        .form-group.password-group
          label(for="confirmPassword") Confirm Password
          .password-wrapper
            input(type="password" id="confirmPassword" name="confirmPassword")
            button(type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)")
              i(class="fa fa-eye")
          if errors && errors.confirmPassword
            p.error-message(style="color:red")= errors.confirmPassword

        if errors && errors.general
          p.error-message(style="color:red")= errors.general

        button.button(type="submit") Register

        p.register-text
          | Already have an account?
          a(href="/login") Sign In

    // Password toggle JS
    script.
      function togglePassword(fieldId, btn) {
        const field = document.getElementById(fieldId);
        const icon = btn.querySelector('i');
        if (field.type === 'password') {
          field.type = 'text';
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          field.type = 'password';
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      }
