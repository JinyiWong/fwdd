extends layout/result.layout.pug

block content
  .card.leaderboard
    h2 Results
    if message
      p(style="color:#ff8080;") #{message}
    else
      p Here are the final scores for this game session.

      // 🔹 Responsive table wrapper
      .table-wrapper
        table
          thead
            tr
              th Rank
              th Player
              th Score
              th Time Taken (minutes)
          tbody
            each player in players
              tr
                td #{player.rank}
                td #{player.name}
                td #{player.score}
                td #{player.time}

      // 🔹 Action Button
      .action-btn-container
        button.action-btn(type="button" onclick="window.location.href='/question_recap'") View Answered Question
