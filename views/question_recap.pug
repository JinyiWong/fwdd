doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Question Recap
    link(rel="stylesheet", href="/css/question.recap.css")
    link(href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;500;600;700;800&display=swap", rel="stylesheet")

  body
    header.dashboard-header
      div.left-header
        a.back(href="/results")
          img(src="/images/back.png", alt="Back", class="back-icon")
          | Back

        div.logo
          img(src="/images/logo.png", alt="Python Escape Logo")
          div.header-text
            h1 Question Recap
            span Review the questions you answered

      a.logout(href="/logout")
        img(src="/images/logout.png", alt="Logout", class="logout-icon")
        | Back to Home

    main.recap-container
      .card.results-summary
        h2 Congrats! You have escaped!
        .stats-container
          .stat
            h3= score
            p Score
          .stat
            h3= timeTaken
            p Time Taken
          .stat
            h3= itemsCollected
            p Items Collected
          .stat
            h3 #{accuracy}%
            p Accuracy

      if answers && answers.length
        each a, i in answers
          .card.question-card
            h3 Question #{i + 1}:
            p.question-text= a.question_text

            if a.code_example
              pre.code-block= a.code_example

            .answers
              // ✅ Highlight player's choice and correct answer
              button.option(
                class=a.selected_option === 'A' ? (a.correct_answer === 'A' ? 'correct' : 'wrong') : (a.correct_answer === 'A' ? 'highlight-correct' : '')
              )= a.option_a
              button.option(
                class=a.selected_option === 'B' ? (a.correct_answer === 'B' ? 'correct' : 'wrong') : (a.correct_answer === 'B' ? 'highlight-correct' : '')
              )= a.option_b
              button.option(
                class=a.selected_option === 'C' ? (a.correct_answer === 'C' ? 'correct' : 'wrong') : (a.correct_answer === 'C' ? 'highlight-correct' : '')
              )= a.option_c
              button.option(
                class=a.selected_option === 'D' ? (a.correct_answer === 'D' ? 'correct' : 'wrong') : (a.correct_answer === 'D' ? 'highlight-correct' : '')
              )= a.option_d

            .explanation
              span.label Explanation:
              p= a.explanation
      else
        .card
          p(style="color:#ccc; text-align:center;") No answers found for this session.
